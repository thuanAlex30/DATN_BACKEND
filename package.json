{
  "name": "safety-management-backend",
  "version": "1.0.0",
  "description": "Backend API for Safety Management System",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:kafka": "jest tests/kafka",
    "test:integration": "jest tests/integration",
    "test:e2e": "jest tests/e2e",
    "test:stress": "jest tests/stress",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "kafka:start": "docker-compose up -d kafka zookeeper",
    "kafka:stop": "docker-compose down",
    "kafka:topics": "node scripts/create-kafka-topics.js",
    "kafka:monitor": "node scripts/kafka-monitor.js",
    "service:audit": "node scripts/start-audit-service.js",
    "service:analytics": "node scripts/start-analytics-service.js",
    "service:event-aggregator": "node scripts/start-event-aggregator.js",
    "db:seed:tenants": "node scripts/seed-tenants-and-roles.js",
    "db:seed:full": "node scripts/seed-full-tenants.js",
    "db:create:admin": "node scripts/create-admin.js",
    "db:create:roles": "node scripts/create-roles.js",
    "db:remove:team-leader": "node scripts/remove-team-leader-role.js",
    "db:reset:users": "node scripts/reset-and-create-users.js",
    "test:pricing-config": "node scripts/test-pricing-config.js",
    "test:payos": "node scripts/test-payos.js",
    "test:email": "node scripts/test-email.js",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f",
    "docker:restart": "docker-compose restart",
    "docker:prod": "docker-compose -f docker-compose.prod.yml up -d",
    "docker:prod:down": "docker-compose -f docker-compose.prod.yml down",
    "docker:kafka:topics": "docker exec safety-kafka kafka-topics --bootstrap-server localhost:9092 --list",
    "docker:kafka:create-topics": "docker exec safety-kafka-init bash -c 'kafka-topics --bootstrap-server kafka:29092 --list'"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@mhoc/axios-digest-auth": "^0.8.0",
    "@payos/node": "^2.0.3",
    "@pdf-lib/fontkit": "^1.1.1",
    "axios": "^1.5.0",
    "bcryptjs": "^2.4.3",
    "bull": "^4.11.3",
    "cloudinary": "^2.8.0",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "exceljs": "^4.3.0",
    "express": "^4.18.2",
    "express-rate-limit": "^6.10.0",
    "express-validator": "^7.0.1",
    "fontkit": "^2.0.4",
    "helmet": "^7.0.0",
    "html2canvas": "^1.4.1",
    "joi": "^17.9.2",
    "jsonwebtoken": "^9.0.2",
    "jspdf": "^3.0.3",
    "k6": "^0.0.0",
    "kafkajs": "^2.2.4",
    "lodash": "^4.17.21",
    "moment": "^2.29.4",
    "mongoose": "^7.5.0",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "node-cache": "^5.1.2",
    "node-cron": "^3.0.2",
    "nodemailer": "^6.10.1",
    "pdf-lib": "^1.17.1",
    "pdfkit": "^0.13.0",
    "prom-client": "^14.2.0",
    "sharp": "^0.32.5",
    "socket.io": "^4.7.2",
    "socket.io-client": "^4.8.1",
    "twilio": "^4.15.0",
    "uuid": "^9.0.0",
    "winston": "^3.10.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.4",
    "artillery": "^2.0.0",
    "eslint": "^8.47.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-plugin-import": "^2.28.1",
    "eslint-plugin-jest": "^27.4.2",
    "jest": "^29.6.2",
    "mongodb-memory-server": "^10.3.0",
    "nodemon": "^3.1.11",
    "supertest": "^6.3.3"
  },
  "jest": {
    "testEnvironment": "node",
    "collectCoverageFrom": [
      "services/**/*.js",
      "events/**/*.js",
      "controllers/**/*.js",
      "middlewares/**/*.js",
      "!**/node_modules/**",
      "!**/coverage/**"
    ],
    "coverageReporters": [
      "text",
      "lcov",
      "html"
    ],
    "testMatch": [
      "**/tests/**/*.test.js",
      "**/tests/**/*.spec.js"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/tests/setup.js"
    ]
  },
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=8.0.0"
  },
  "keywords": [
    "safety",
    "management",
    "kafka",
    "websocket",
    "mongodb",
    "express",
    "api"
  ],
  "author": "Safety Management Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/your-org/safety-management-backend.git"
  },
  "bugs": {
    "url": "https://github.com/your-org/safety-management-backend/issues"
  },
  "homepage": "https://github.com/your-org/safety-management-backend#readme"
}
